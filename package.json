{
  "name": "dsh-dingtalk",
  "version": "0.3.3",
  "description": "把任务结果发送到钉钉群机器人的通知插件。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "node": "./lib/client.js",
      "default": "./lib/update-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-updates.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dingtalk",
    "dingtalk-robot",
    "webhook"
  ],
  "author": "stardustlc",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "url": "git+https://github.com/STARDUSTLC666/dsh-dingtalk.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-dingtalk/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-dingtalk#readme",
  "dependencies": {
    "@stardustlc/dsh-updates": "0.1.3"
  }
}
