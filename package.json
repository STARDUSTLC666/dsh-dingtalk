{
  "name": "dsh-dingtalk",
  "version": "0.4.10",
  "description": "DeepSeek Harness 钉钉群通知插件：发送文本与 Markdown 消息，支持加签校验、凭证脱敏与配置自检。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "node": "./lib/client.js",
      "default": "./lib/update-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-updates.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dingtalk",
    "dingtalk-robot",
    "webhook",
    "deepseek",
    "ai-agent",
    "bot",
    "notification",
    "钉钉",
    "机器人"
  ],
  "author": "stardustlc",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "url": "git+https://github.com/STARDUSTLC666/dsh-dingtalk.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-dingtalk/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-dingtalk#readme",
  "dependencies": {
    "@stardustlc/dsh-updates": "0.2.11"
  },
  "icon": "./assets/plugin-icon.webp"
}
